@url = http://localhost:8080

### Register
POST {{url}}/auth/register HTTP/1.1
Content-Type: application/json

{
	"name": "Dev Usman",
	"email": "baba@test.com",
	"password": "pass1234"
}

### Login User
POST http://localhost:8080/auth/login HTTP/1.1
Content-Type: application/json

{
	"email": "baba@test.com",
	"password": "pass1234"
}
