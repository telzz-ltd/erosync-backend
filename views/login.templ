package views

import "erosync/views/components"

templ LoginContent() {
	<div class="grid grid-cols-2 min-h-screen">
		<div class="bg-primary"></div>
		<div class="flex flex-col items-center justify-center bg-gray-100">
			<form hx-post="/login" hx-target="#form-errors" hx-swap="innerHTML" class="w-125 space-y-6">
				<div>
					<h3 class="text-3xl font-bold">Sign In</h3>
					<p class="text-muted-foreground">Enter your detials to access the portal</p>
				</div>
				<div id="form-errors"></div>
				<div class="space-y-4">
					@components.Input("email", "email", "Email Address", "")
					@components.Input("password", "password", "Password", "")
				</div>
				<button type="submit" class="h-12 w-full bg-primary text-white uppercase font-medium">Sign In</button>
			</form>
			// <Link class="text-primary hover:underline" to="/forgot-password">
			// Forgot Password
			// </Link>
			<button
				hx-post="/confirmed"
				hx-confirm="Some confirm text here"
			>
				Click Me
			</button>
		</div>
	</div>
}

templ Login() {
	@components.Base("Login", LoginContent())
}
